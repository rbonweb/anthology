#!/bin/sh
# rtk-hook: the PreToolUse (Bash) hook. Runs `rtk hook claude` with the hook input on stdin.
# If rtk is not installed it exits 0 without output, so the hook never blocks a command.
# Same state.json lookup as bin/rtk (tests/test_rtk_install.py checks both).
state=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/anthology/state.json
rtk_path=
if [ -f "$state" ] && [ -r "$state" ]; then
  rtk_path=$(sed -n 's/^ *"rtk_path": *"\([^"]*\)",\{0,1\} *$/\1/p' "$state" 2>/dev/null | head -n 1)
fi
case $rtk_path in
  *\\*|*\"*) exit 0 ;;
  /*) ;;
  *) exit 0 ;;
esac
if [ ! -f "$rtk_path" ] || [ ! -x "$rtk_path" ]; then
  exit 0
fi
# rtk keeps a local history of the command lines it sees (tracking, 90 days), a recall store of
# output it elided (30 days) and a tee spool. Keep them next to state.json, not in rtk's default
# data folder, so /anthology:setup remove deletes them (README "Local history", SECURITY.md).
rtk_data=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/anthology/rtk
RTK_DB_PATH=$rtk_data/history.db
RTK_RECALL_DB=$rtk_data/recall.db
RTK_TEE_DIR=$rtk_data/tee
export RTK_DB_PATH RTK_RECALL_DB RTK_TEE_DIR
RTK_SUPPRESS_HOOK_WARNING=1
export RTK_SUPPRESS_HOOK_WARNING
# A hook "ask" prompts in every permission mode, bypass and auto included, and rtk asks for
# many commands it leaves as typed (`node --version; bun --version`). So an ask is dropped:
# the command then runs as typed, under the user's own mode and rules, as it would without rtk.
# Kept: a deny, a non-zero exit, and an ask on a line that mentions rtk, which `Bash(rtk *)`
# would otherwise allow. The rtk test mirrors the gate's `mentions_rtk` on the value of every
# `"command"` key of the raw hook input (quotes and backslashes removed, a line continuation
# joined, case folded; a `$'` counts as a mention). In JSON a quote inside a string is always
# `\"`, so the pattern below only ever matches a real key and its whole string value. A `\u`
# escape anywhere (a key spelled with one too) counts as a mention, and an input with no such
# key is matched whole: both only keep more asks.
input=$(cat)
out=$(printf '%s' "$input" | "$rtk_path" hook claude)
rc=$?
if [ "$rc" -eq 0 ] &&
   printf '%s' "$out" | grep -Eq '"permissionDecision"[[:space:]]*:[[:space:]]*"ask"' &&
   ! printf '%s' "$out" | grep -Eq '"permissionDecision"[[:space:]]*:[[:space:]]*"deny"'; then
  case $input in
    *'\u'*) ;;
    *)
      cmd=$(printf '%s' "$input" | tr -d '\n\r' |
        LC_ALL=C grep -Eo '"command"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"')
      [ -n "$cmd" ] || cmd=$input
      case $cmd in
        *"\$'"*) ;;
        *) printf '%s' "$cmd" | LC_ALL=C sed 's/\\n//g' | LC_ALL=C tr -d "\\\\\"'" |
             LC_ALL=C grep -qi rtk || exit 0 ;;
      esac ;;
  esac
fi
[ -z "$out" ] || printf '%s\n' "$out"
exit "$rc"
