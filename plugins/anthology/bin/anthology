#!/bin/sh
# anthology: run the anthology binary this plugin's anthology.lock pins, installing it first
# when it is missing (design §8.4 `wrapper` mode). Exit 127 when it cannot be installed.
ATL_SUPPRESS_HOOK_WARNING=1
export ATL_SUPPRESS_HOOK_WARNING
unset CDPATH
anth_name=anthology
anth_self=$0
while [ -h "$anth_self" ]; do
    anth_link=$(readlink "$anth_self")
    case $anth_link in
        /*) anth_self=$anth_link ;;
        *) anth_self=$(dirname "$anth_self")/$anth_link ;;
    esac
done
anth_root=$(cd "$(dirname "$anth_self")/.." && pwd)
anth_fail() {
    printf '%s: the anthology binary is not installed (%s); start a new session while online, or run /anthology:setup\n' "$anth_name" "$1" >&2
    exit 127
}
if [ -z "$anth_root" ] || [ ! -f "$anth_root/hooks/lib.sh" ] ||
    ! (command . "$anth_root/hooks/lib.sh") >/dev/null 2>&1; then
    anth_fail 'hooks/lib.sh did not load'
fi
# shellcheck source=../hooks/lib.sh
command . "$anth_root/hooks/lib.sh"
if anth_resolve "$anth_root" && anth_installed; then
    exec "$ANTH_BIN" "$@"
fi
# A caller inside a short hook (the permission mod) sets ANTHOLOGY_NO_INSTALL: never download
# or install there, exit 127 at once. Any non-empty value counts.
if [ -n "${ANTHOLOGY_NO_INSTALL-}" ]; then
    anth_fail 'ANTHOLOGY_NO_INSTALL is set'
fi
anth_paths "$anth_root"
anth_st=$(anth_bootstrap_main wrapper --plugin anthology --quiet </dev/null 2>/dev/null)
case $anth_st in
    status=present | status=installed)
        if anth_resolve "$anth_root" && anth_installed; then
            exec "$ANTH_BIN" "$@"
        fi
        anth_fail 'the binary is missing after the install'
        ;;
    status=failed:?*) anth_fail "${anth_st#status=failed:}" ;;
esac
anth_fail 'the bootstrap gave no status'
