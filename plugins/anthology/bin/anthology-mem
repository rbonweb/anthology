#!/bin/sh
# anthology-mem: search, explore and save Anthology memory notes (search, related, orphans, stale,
# rebuild, save). A thin POSIX wrapper around scripts/memory_index.py.
if ! command -v python3 >/dev/null 2>&1; then
  echo "anthology-mem: python3 not found" >&2
  exit 127
fi
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd)
exec python3 "$here/../scripts/memory_index.py" "$@"
