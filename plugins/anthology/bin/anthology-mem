#!/bin/sh
# anthology-mem: search, explore and save Anthology memory notes (search, related, orphans,
# stale, rebuild, save). Runs `anthology mem` with the binary this plugin's anthology.lock pins,
# installing it first when it is missing (design §8.4 `wrapper` mode). Exit 127 when it cannot
# be installed.
ATL_SUPPRESS_HOOK_WARNING=1
export ATL_SUPPRESS_HOOK_WARNING
unset CDPATH
anth_name=anthology-mem
anth_self=$0
# readlink and dirname below run on PATH without its relative and empty entries, as lib.sh's
# anth_safe_path makes it (lib.sh is not loaded yet), so the folder this runs in cannot supply
# them. PATH itself stays as the caller set it: the binary gets it.
anth_safe=$(
    anth_in=${PATH-}
    PATH=/usr/bin:/bin
    set -f
    IFS=:
    # shellcheck disable=SC2086 # split on IFS (`:`) on purpose; globbing is off
    for anth_dir in $anth_in; do
        # `(/*)`: bash 3.2 misreads a bare `/*)` inside `$( )`.
        case $anth_dir in
            (/*) printf '%s:' "$anth_dir" ;;
        esac
    done
)
anth_safe=${anth_safe%:}
[ -n "$anth_safe" ] || anth_safe=/usr/bin:/bin:/usr/sbin:/sbin
while [ -h "$anth_self" ]; do
    anth_link=$(PATH=$anth_safe && readlink "$anth_self")
    case $anth_link in
        /*) anth_self=$anth_link ;;
        *) anth_self=$(PATH=$anth_safe && dirname "$anth_self")/$anth_link ;;
    esac
done
anth_root=$(cd "$(PATH=$anth_safe && dirname "$anth_self")/.." && pwd)
anth_fail() {
    printf '%s: the anthology binary is not installed (%s); start a new session while online, or run /anthology:setup\n' "$anth_name" "$1" >&2
    exit 127
}
if [ -z "$anth_root" ] || [ ! -f "$anth_root/hooks/lib.sh" ] ||
    ! (command . "$anth_root/hooks/lib.sh") >/dev/null 2>&1; then
    anth_fail 'hooks/lib.sh did not load'
fi
# shellcheck source=../hooks/lib.sh
command . "$anth_root/hooks/lib.sh"
if anth_resolve "$anth_root" && anth_installed; then
    anth_user_path
    exec "$ANTH_BIN" mem "$@"
fi
# A caller inside a short hook (the permission mod) sets ANTHOLOGY_NO_INSTALL: never download
# or install there, exit 127 at once. Any non-empty value counts.
if [ -n "${ANTHOLOGY_NO_INSTALL-}" ]; then
    anth_fail 'ANTHOLOGY_NO_INSTALL is set'
fi
anth_paths "$anth_root"
anth_st=$(anth_bootstrap_main wrapper --plugin anthology --quiet </dev/null 2>/dev/null)
case $anth_st in
    status=present | status=installed)
        if anth_resolve "$anth_root" && anth_installed; then
            anth_user_path
            exec "$ANTH_BIN" mem "$@"
        fi
        anth_fail 'the binary is missing after the install'
        ;;
    status=failed:?*) anth_fail "${anth_st#status=failed:}" ;;
esac
anth_fail 'the bootstrap gave no status'
