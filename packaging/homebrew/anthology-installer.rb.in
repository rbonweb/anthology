class AnthologyInstaller < Formula
  desc "One-command installer for the Anthology plugins for Claude Code"
  homepage "https://github.com/rbonweb/anthology"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "@BASE_URL@/anthology-installer-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "@BASE_URL@/anthology-installer-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE_URL@/anthology-installer-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "@BASE_URL@/anthology-installer-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "anthology-installer"
  end

  def caveats
    <<~EOS
      Claude Code must already be installed: the installer never installs it.
      Then run:
        anthology-installer
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/anthology-installer --version")
    assert_match "usage: anthology-installer", shell_output("#{bin}/anthology-installer --help")
  end
end
